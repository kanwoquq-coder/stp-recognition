# 服务端口
API_HOST=0.0.0.0
API_PORT=8001

# 文本 Embedding 服务（用于建库和文本召回）
API_KEY=your_api_key_here
BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large

# LLM 精排服务（可指向独立的 OpenAI 兼容 Qwen 服务）
# 示例：LLM_BASE_URL=http://10.100.0.34:8223/v1
LLM_API_KEY=
LLM_BASE_URL=
MODEL=gpt-4o

# 模型调用兼容参数
# Qwen3/3.5 建议关闭思考，避免JSON前出现长推理文本；auto/on/off
LLM_THINKING=off
# auto会优先请求JSON模式，服务不支持时自动去掉response_format；auto/json/none
LLM_RESPONSE_FORMAT=auto
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1
# vLLM多模态部署常限制每次只能传1张图片
STP_LLM_MAX_IMAGES=1

# 数据目录；不填写时均保存在 stpnew/runtime
# RUNTIME_DIR=D:/stpnew-runtime
# LIBRARY_DIR=D:/your-local-stp-library
# DB_PATH=D:/stpnew-runtime/chroma_parts
# RENDER_DIR=D:/stpnew-runtime/renders

# 浏览器主流程应使用 file_id。仅当后端和零件库在同一台可信机器时开启。
ALLOW_LOCAL_PATHS=false

MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
